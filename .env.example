# 高德 JS API 的浏览器 Key；开发和生产构建都需要填写。
# VITE_* 会打包进浏览器，不要给安全密钥添加此类前缀。
VITE_AMAP_KEY=

# 推荐本地方案：填写配套的安全密钥，仅由 Vite 的 Node 代理读取。
# 修改后重启 npm run dev / npm run preview；生产静态站点仍需配置主机代理。
AMAP_SECURITY_CODE=

# 备选方案：不填上面的安全密钥时，转发到已配置高德代理的网站源地址。
# 例如 https://你的域名（不带路径）；该站点必须实际返回高德数据，不能返回首页 HTML。
AMAP_PROXY_TARGET=

# 二手平台 API 地址；默认为用户提供的服务地址。
VITE_API_BASE_URL=http://121.40.220.225:8080

# 开发/preview 推荐开启；Vite 会把 /api 与 /uploads 转发到上面的地址，浏览器不会跨域。
# 生产站点若没有反向代理，请改为 false，并让后端开启 CORS。
VITE_API_USE_PROXY=true
